<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uuv_safety</name>
  <version>1.0.0</version>
  <description>safety_monitor: watches the vehicle and cuts thruster commands on a fault</description>
  <maintainer email="kait07mkc@gmail.com">Kaitlyn Chit</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>uuv_msgs</depend>
  <depend>pwm_msg</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>